# Ceramic Network Configuration
# This is the primary Ceramic node to use in production
NEXT_PUBLIC_CERAMIC_NODE=https://ceramic-clay.3boxlabs.com

# Environment (development or production)
NODE_ENV=development

# Enable or disable local node usage (true/false)
# Set to false in production environments
NEXT_PUBLIC_USE_LOCAL_NODE=true

# Local node URL (only used in development)
NEXT_PUBLIC_LOCAL_CERAMIC_NODE=http://localhost:7007

# Connection timeout in milliseconds
NEXT_PUBLIC_CERAMIC_CONNECTION_TIMEOUT=5000
