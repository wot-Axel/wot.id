# Ceramic Network Configuration
# Copy this file to .env.local for local development

# Primary Ceramic node (required for production)
NEXT_PUBLIC_CERAMIC_NODE=https://ceramic-clay.3boxlabs.com

# ComposeDB network (required for production)
# Options: testnet-clay, mainnet
NEXT_PUBLIC_COMPOSEDB_NETWORK=testnet-clay

# Connection timeout in milliseconds (optional)
NEXT_PUBLIC_CERAMIC_TIMEOUT=15000

# Health check timeout in milliseconds (optional)
NEXT_PUBLIC_CERAMIC_HEALTH_CHECK_TIMEOUT=7500
