{
  "extends": "next/core-web-vitals",
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  },
  "globals": {
    "React": "readonly",
    "alert": "readonly",
    "AbortController": "readonly",
    "setTimeout": "readonly",
    "clearTimeout": "readonly",
    "Buffer": "readonly",
    "CryptoKey": "readonly"
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "react/no-unescaped-entities": "off",
    "no-unused-vars": "warn",
    "no-undef": "warn"
  },
  "overrides": [
    {
      "files": [
        "src/components/AttestationForm.tsx",
        "src/components/ConversationView.tsx",
        "src/components/ConversationList.tsx",
        "src/components/NewConversationModal.tsx",
        "src/app/chat/page.tsx",
        "src/hooks/useWalletPreferences.ts",
        "src/utils/optimismProvider.ts",
        "src/config/index.ts",
        "src/components/Scanner.tsx"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    },
    {
      "files": [
        "src/utils/ceramicConnector.ts"
      ],
      "rules": {
        "no-undef": "off",
        "no-unused-vars": "off",
        "@typescript-eslint/no-unused-vars": "off"
      }
    },
    {
      "files": [
        "src/composedb/config.ts",
        "src/utils/encryptionUtils.ts",
        "src/app/layout.tsx",
        "src/components/AccountsPasswordsSection.tsx"
      ],
      "rules": {
        "no-undef": "off"
      }
    },
    {
      "files": [
        "src/components/AccountsPasswordsSection.tsx",
        "src/components/HumanRelationshipsSection.tsx",
        "src/components/MedicalDataSection.tsx",
        "src/components/OrganizationalAffiliationsSection.tsx",
        "src/components/PrivateDataSection.tsx"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    }
  ]
}
