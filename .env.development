# Development environment variables
# This file is for local development only and should not contain sensitive information

# Use the public development project ID (already in the code as fallback)
NEXT_PUBLIC_PROJECT_ID="b56e18d47c72ab683b10814fe9495694"

# Allow development origins for authentication
NEXT_PUBLIC_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Force development mode for authentication
NEXT_PUBLIC_NODE_ENV="development"

# Disable strict SSL for development
NODE_TLS_REJECT_UNAUTHORIZED="0"

# Disable HTTP/2 for development (can cause issues with some auth providers)
NEXT_PUBLIC_HTTP2="false"
